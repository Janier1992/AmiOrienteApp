# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube a git (ya está en .gitignore).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo para presentaciones: completa listados vacíos con datos de ejemplo.
# NUNCA lo actives en producción (los clientes verían negocios inexistentes).
# VITE_DEMO_MODE=true

# Datos de la persona jurídica que opera la plataforma (aparecen en Términos, Privacidad y Contacto).
# DEBEN completarse antes de comercializar. Se definen también en GitHub → Settings → Variables (Actions).
# VITE_LEGAL_NAME=Razón social S.A.S.
# VITE_LEGAL_NIT=900.000.000-0
# VITE_LEGAL_ADDRESS=Calle 00 # 00-00, Marinilla, Antioquia
# VITE_LEGAL_PHONE=3000000000
# VITE_LEGAL_EMAIL=privacidad@tudominio.com

# Mapas (opcional). Por defecto se usan los servidores públicos de OpenStreetMap, aptos para el piloto pero con
# política de uso. Para producción con volumen, usar un proveedor de teselas comercial o un servidor propio y
# añadir su dominio a img-src / connect-src de vercel.json.
# VITE_MAP_TILE_URL=https://tiles.ejemplo.com/{z}/{x}/{y}.png?key=TU_CLAVE
# VITE_MAP_TILE_ATTRIBUTION=&copy; Proveedor de mapas
# VITE_GEOCODER_URL=https://geocoder.ejemplo.com
